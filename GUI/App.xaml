<Application x:Class="GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GUI"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <!--
        ThemeMode="System" 启用 .NET 10 WPF 内置的 Fluent 主题：
        它同时提供控件样式（Menu / Button / TextBox / TreeView / CheckBox 等）
        与主题资源（LayerFillColor*、TextFillColor*、DividerStrokeColor* 等），
        并跟随 Windows 的浅色 / 深色设置自动切换。

        主题资源来自 .NET 10 Desktop Runtime 内置的 PresentationFramework.Fluent
        程序集，无需任何第三方 Fluent UI 库，也无需手动合并资源字典。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!--
                合并的参数行模板字典。模板内部用到的转换器（BoolToVisibility /
                BoolToOnOff / StringNonEmptyToVisibility）已在 ParameterTemplates.xaml
                内部声明 —— 被合并的字典无法 StaticResource 引用本层的资源。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ParameterTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>