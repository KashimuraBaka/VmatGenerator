<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GUI.ViewModels"
        xmlns:lib="clr-namespace:Lib;assembly=Lib"
        xmlns:local="clr-namespace:GUI"
        mc:Ignorable="d"
        Title="VMAT 生成器"
        Height="780" Width="1280"
        MinHeight="520" MinWidth="900"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel x:Name="RootVm" />
    </Window.DataContext>

    <!--
        顶部布局：菜单栏 + 工具栏 + 三栏网格（导航 | 编辑器 | 预览）。
        所有控件均为 WPF 原生类型，Fluent 样式由 App.xaml 中的
        ThemeMode="System" 自动提供（.NET 10 内置 Fluent 主题）。
        图标字体使用 Windows 自带的 "Segoe Fluent Icons" / "Segoe MDL2 Assets"。
    -->
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 菜单栏 -->
            <RowDefinition Height="Auto" />
            <!-- 工具栏 -->
            <RowDefinition Height="*" />
            <!-- 主体 -->
            <RowDefinition Height="Auto" />
            <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ─── 菜单栏 ───────────────────────────────────────────────────── -->
        <Menu Grid.Row="0" Background="Transparent">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建 VMAT(_N)"   Command="{Binding NewVmatCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="打开文件夹(_O)…" Command="{Binding OpenFolderCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="保存(_S)"  Command="{Binding SaveCurrentCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="另存为(_A)…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="复制 KV 文本(_C)" Command="{Binding Editor.CopyKvCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="刷新(_R)"         Command="{Binding RefreshCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="按着色器过滤(_S)…" x:Name="FilterMenuItem" Click="OnFilterMenuClicked" />
                <MenuItem Header="清除过滤(_C)"      Command="{Binding ClearFilterCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="错误日志(_L)…" Click="OnShowErrorLogClicked" />
                <MenuItem Header="打开日志目录(_F)…" Click="OnOpenLogFolderClicked" />
                <Separator />
                <MenuItem Header="关于(_A)…" Click="OnAboutClicked" />
            </MenuItem>
        </Menu>

        <!-- ─── 工具栏 ────────────────────────────────────────────────── -->
        <ToolBar Grid.Row="1" Background="Transparent">
            <Button Command="{Binding NewVmatCommand}" ToolTip="新建 VMAT (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="新建" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenFolderCommand}" ToolTip="打开文件夹 (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="打开" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Command="{Binding SaveCurrentCommand}" ToolTip="保存 (Ctrl+S)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="保存" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveAsCommand}" ToolTip="另存为 (Ctrl+Shift+S)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE792;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="另存为…" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Command="{Binding Editor.CopyKvCommand}" ToolTip="复制 KV 文本">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="复制 KV" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding RefreshCommand}" ToolTip="刷新 (F5)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="刷新" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Command="{Binding FilterByShaderCommand}" ToolTip="按着色器过滤">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="过滤" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearFilterCommand}" ToolTip="清除过滤">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE894;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="清除" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- ─── 三栏主体 ────────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左：TreeView 风格的着色器分组 -->
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorAltBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="材质列表" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ShaderGroups.Count, StringFormat='{}{0} 个着色器'}"
                                   FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="FilterInputBox"
                                     Text="{Binding ShaderFilter, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="按着色器名称过滤…"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       Margin="6,4,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <!-- BasedOn 保留 Fluent 的 TextBlock 隐式样式（字号/字重/文本填充色） -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FilterInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Margin="6,0,0,0"
                                Command="{Binding FilterByShaderCommand}"
                                ToolTip="应用过滤">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" />
                        </Button>
                    </Grid>
                    <TreeView ItemsSource="{Binding ShaderGroups}"
                              BorderThickness="0"
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ShaderGroupViewModel}"
                                                      ItemsSource="{Binding MaterialEntries}">
                                <TextBlock Text="{Binding ShaderName}" FontWeight="SemiBold" />
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MaterialEntryViewModel}">
                                        <Button Click="OnMaterialEntryClicked"
                                                Tag="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C3;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- 中：参数编辑器 -->
            <Border Grid.Column="2" Padding="16" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Editor.SelectedShaderDisplay}"
                                       FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Editor.MaterialFilePath}"
                                       FontSize="11" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="复制 KV" Command="{Binding Editor.CopyKvCommand}" />
                            <Button Content="保存"   Command="{Binding SaveCurrentCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 着色器信息与说明 -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12"
                            Background="{DynamicResource LayerFillColorAltBrush}"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedShaderTemplate.Description}"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Editor.ParameterRows}">
                            <ItemsControl.ItemTemplateSelector>
                                <local:ParameterRowTemplateSelector />
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- 右：KV 预览 -->
            <Border Grid.Column="4" Background="{DynamicResource LayerFillColorAltBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="KeyValues 预览" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="复制"
                                Command="{Binding Editor.CopyKvCommand}"
                                ToolTip="复制 KV 文本到剪贴板" />
                    </Grid>
                    <TextBox Text="{Binding Editor.GeneratedText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Cascadia Mono, Consolas, 微软雅黑"
                             FontSize="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Margin="6,0,6,6" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ─── 状态栏 ──────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Padding="12,4"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Fluent UI / .NET 10 WPF"
                           Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Margin="0,0,12,0" Padding="8,2"
                        FontSize="11" Content="错误日志"
                        Click="OnShowErrorLogClicked"
                        ToolTip="查看控件错误记录" />
                <!-- 非阻塞错误角标：出错时出现，点击可打开错误日志 -->
                <Button x:Name="ErrorBanner" DockPanel.Dock="Right" Margin="0,0,12,0"
                        Padding="8,2" FontSize="11" Visibility="Collapsed"
                        Content="⚠ 0" Click="OnShowErrorLogClicked"
                        ToolTip="点击查看错误日志">
                    <Button.Style>
                        <!-- 同样需要 BasedOn，否则会顶掉 Fluent 的按钮隐式样式 -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>