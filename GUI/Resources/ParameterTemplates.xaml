<ResourceDictionary x:Class="GUI.Resources.ParameterTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GUI.ViewModels"
                    xmlns:local="clr-namespace:GUI">

    <!--
        共享行 chrome。每行采用「左侧标签 + 右侧编辑器」两栏布局；可见性绑定
        ParameterRowViewModel.IsVisible，从而支持子组开关关闭时自动隐藏。
        所有控件均为 WPF 原生类型，样式由 App.xaml 中的 ThemeMode="System" 提供。

        ⚠ 关键：下面这些转换器必须声明在<b>本字典内部</b>。
        WPF 的 MergedDictionaries 是单向的 —— 被合并进来的字典无法用 StaticResource
        引用合并方（App.xaml）里定义的资源，解析期会抛
        「无法找到名为 "BoolToVisibility" 的资源」。因此凡是在本文件中被
        StaticResource 引用的资源，都必须在本文件内自行声明。
    -->
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BoolToOnOffConverter x:Key="BoolToOnOff" />
    <local:StringNonEmptyToVisibilityConverter x:Key="StringNonEmptyToVisibility" />

    <Style x:Key="ParamRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!--
        数值 TextBox 样式：限制输入为数字、可选负号、单个小数点。

        ⚠ BasedOn="{StaticResource {x:Type TextBox}}" 是必须的。
        .NET 10 内置 Fluent 主题是以「隐式样式」（键 = 控件类型）形式提供的，
        只要控件没有显式 Style 就会自动套用；而一旦指定了显式 Style，
        隐式样式就被整体顶替掉 —— 不写 BasedOn 就会退回 WPF 默认外观，
        表现为输入框失去 Fluent 的圆角、边框与悬停/聚焦效果。

        PreviewTextInput / Pasting 通过 EventSetter 挂到本字典代码后置的静态处理器。
    -->
    <Style x:Key="NumericTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinWidth" Value="120" />
        <EventSetter Event="PreviewTextInput"
                     Handler="NumericTextBox_PreviewTextInput" />
        <EventSetter Event="DataObject.Pasting"
                     Handler="NumericTextBox_Pasting" />
    </Style>

    <!-- 布尔参数：使用 Fluent 样式的 CheckBox 作为开关。 -->
    <DataTemplate x:Key="BoolTemplate" DataType="{x:Type vm:BoolParameter}">
        <Border Style="{StaticResource ParamRowStyle}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Key}" FontSize="11" Opacity="0.5" />
                </StackPanel>
                <CheckBox Grid.Column="1"
                          Content="{Binding Value, Converter={StaticResource BoolToOnOff}}"
                          IsChecked="{Binding Value, Mode=TwoWay}"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 标量参数（Float / Int）：原生 TextBox + 数字验证。 -->
    <DataTemplate x:Key="ScalarTemplate" DataType="{x:Type vm:ScalarParameter}">
        <Border Style="{StaticResource ParamRowStyle}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Key}" FontSize="11" Opacity="0.5" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Style="{StaticResource NumericTextBoxStyle}"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.######}}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Vector4 参数：四个并列 TextBox 编辑 x y z w。 -->
    <DataTemplate x:Key="VectorTemplate" DataType="{x:Type vm:VectorParameter}">
        <Border Style="{StaticResource ParamRowStyle}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Key}" FontSize="11" Opacity="0.5" />
                </StackPanel>
                <UniformGrid Grid.Column="1" Rows="1" Columns="4">
                    <DockPanel Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="X" FontSize="11" Opacity="0.6" />
                        <TextBox Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.######}}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Y" FontSize="11" Opacity="0.6" />
                        <TextBox Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.######}}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Z" FontSize="11" Opacity="0.6" />
                        <TextBox Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.######}}" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="W" FontSize="11" Opacity="0.6" />
                        <TextBox Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding W, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.######}}" />
                    </DockPanel>
                </UniformGrid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 贴图参数：原生 TextBox（带占位提示）+ 浏览按钮。 -->
    <DataTemplate x:Key="TextureTemplate" DataType="{x:Type vm:TextureParameter}">
        <Border Style="{StaticResource ParamRowStyle}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Key}" FontSize="11" Opacity="0.5" />
                </StackPanel>
                <!--
                    Grid 叠加：以 TextBlock 显示提示，TextBox 为空时可见，绑定 Text 后自动隐藏。
                -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="TexturePathBox"
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="materials/路径/贴图.png"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsHitTestVisible="False"
                               Margin="6,4,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <!-- BasedOn 保留 Fluent 的 TextBlock 隐式样式 -->
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TexturePathBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="2" Margin="6,0,0,0" Content="浏览…"
                        Command="{Binding BrowseCommand}" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>