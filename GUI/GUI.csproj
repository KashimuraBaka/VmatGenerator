<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GUI</RootNamespace>
    <AssemblyName>GUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Publish profile (used by `dotnet publish`):
      - Single-file apphost for win-x64.
      - SelfContained=false => the .NET 10 Desktop Runtime is NOT bundled; the
        target machine must have it installed (winget install Microsoft.DotNet.DesktopRuntime.10
        or equivalent) for GUI.exe to start.  Only the apphost +
        our app DLLs + third-party managed DLLs (ValveKeyValue,
        CommunityToolkit.Mvvm, Microsoft.Extensions.*) end up inside the
        published single exe.  WPF framework DLLs (PresentationCore,
        PresentationNative_cor3, wpfgfx_cor3, …) and the .NET runtime
        (System.Private.CoreLib, clrjit, coreclr, …) come from the user's
        installed runtime.
      - PublishSingleFile=true => the published artefact is a single exe
        (~4.8 MB).  .NET 10's framework-dependent single-file mode embeds
        all of our managed DLLs inside GUI.exe but does NOT
        embed any runtime DLLs.
      - UseAppHost=true => the single file is a real native apphost exe.
      - WindowsPackageType=None => unpackaged Win32 (NOT an MSIX).
      - WindowsAppSDKSelfContained=false => the WindowsAppRuntime, if used,
        also stays framework-dependent.
      Repro:
        cd H:\dsh-workspace\vmat-generater\VmatGenerator
        dotnet publish GUI -c Release -r win-x64 -o bin/publish
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!--
    .NET 10 ships the Fluent theme (ThemeMode property + the
    PresentationFramework.Fluent resource assembly) which applies Fluent
    styles to stock WPF controls (Menu, MenuItem, TreeView, TreeViewItem,
    Expander, TextBox, CheckBox, etc.).  We merge that theme via App.xaml
    instead of pulling in a third-party Fluent UI library like ModernWpfUI.
    Symbol icons use the Segoe Fluent Icons font that ships with Windows.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Lib\Lib.csproj" />
  </ItemGroup>

</Project>
