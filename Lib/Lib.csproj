<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- IDE 风格提示（.editorconfig 里提升为 warning 的那些）参与构建报告，保证「0 警告」口径与 IDE 一致 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- 库是对外 API：XML 注释缺失 / 写错（CS1591、CS157x）在构建时直接报出来 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Lib</RootNamespace>
    <AssemblyName>Lib</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ValveKeyValue (ValveResourceFormat) is the official Valve-format reader/writer used
      to round-trip every VMAT file we emit. The KV1 text format matches Source 2 VMAT.
      Dependency-free and targets net10.0 so it slots in without bringing extra packages.
    -->
    <PackageReference Include="ValveKeyValue" Version="0.71.0.528" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Per-shader "factory default" VMAT templates rendered by ShaderTemplateEmitter at
      build time. Embedded so the library always has at least one synthesised baseline
      even when no materials/ folder is reachable.
    -->
    <EmbeddedResource Include="Templates\*.vmat" />
  </ItemGroup>

</Project>